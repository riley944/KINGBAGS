# KINGBAGS environment variables
# Copy to .env.local for local dev. In production, set these in
# Vercel → Project → Settings → Environment Variables.
#
# Both are NEXT_PUBLIC_ and therefore visible in the browser bundle.
# That is expected for the anon key — access is restricted by RLS
# (see supabase/schema.sql), not by hiding the key.
#
# Find them in Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
