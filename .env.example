# KINGBAGS environment variables
# Copy to .env.local for local dev. In production, set these in
# Vercel → Project → Settings → Environment Variables.

# --- Supabase (required) ----------------------------------------------------
# NEXT_PUBLIC_ vars are visible in the browser bundle. That is expected for
# the anon key — access is restricted by RLS (see supabase/schema.sql), not
# by hiding the key. Find them in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key: SERVER ONLY (no NEXT_PUBLIC_ prefix — never expose it).
# Powers the /api/admin routes. Supabase → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Ops panel (required for /admin) ----------------------------------------
# Any long random string; it gates every admin API call.
# Generate one with: openssl rand -hex 32
ADMIN_SECRET=

# --- Email via Resend (required for customer status emails) ------------------
# resend.com → API Keys. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=KINGBAGS <orders@kingbags.co>

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://kingbags.co

# --- Analytics (recommended before running ads) -------------------------------
# GA4 measurement ID (G-XXXXXXXXXX). Analytics stays off until set.
NEXT_PUBLIC_GA_ID=

# --- Stripe (required for the order payment flow) -----------------------------
# Dashboard → Developers → API keys. Secret key is SERVER ONLY.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
